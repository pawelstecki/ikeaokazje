[Unit]
Description=IKEA Okazje na Okraglo - monitor (daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=TWOJ_UZYTKOWNIK
WorkingDirectory=/home/TWOJ_UZYTKOWNIK
ExecStart=/usr/bin/python3 /home/TWOJ_UZYTKOWNIK/ikea_okazje.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
