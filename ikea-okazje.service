[Unit]
Description=IKEA Okazje na Okraglo - monitor (daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=TWOJ_UZYTKOWNIK
WorkingDirectory=/home/TWOJ_UZYTKOWNIK
# RUN_MODE=daemon ustaw w ~/.config/ikea-okazje.env, NIE tutaj -
# Environment=RUN_MODE nic nie zmieni, skrypt czyta RUN_MODE tylko z .env.
Environment=PYTHONUNBUFFERED=1
# Ten sam plik blokady co w cronie i przy recznym uruchomieniu (README).
# Gdy blokada jest zajeta, flock -n od razu wychodzi z kodem 75 (-E 75),
# a RestartPreventExitStatus=75 nie restartuje wtedy uslugi - dziala juz
# inna kopia. Inne kody bledow sa restartowane (Restart=on-failure).
ExecStart=/usr/bin/flock -n -E 75 /home/TWOJ_UZYTKOWNIK/.ikea_okazje.lock /usr/bin/python3 /home/TWOJ_UZYTKOWNIK/ikeaokazje/ikea_okazje.py
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=75
# Zatrzymanie moze potrwac do TELEGRAM_LONG_POLL_SECONDS (przy maksimum
# 50 s ok. 65 s) - miesci sie w domyslnym TimeoutStopSec=90s.

# Utwardzenie: skrypt pisze tylko w katalogu domowym uzytkownika i laczy
# sie z siecia (IKEA, Telegram, SMTP), wiec bez ProtectHome/PrivateNetwork.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
