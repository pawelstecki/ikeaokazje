# Skopiuj ten plik do ~/.config/ikea-okazje.env i wypelnij, potem:
#   chmod 600 ~/.config/ikea-okazje.env
#
# To jest jedyne miejsce, w ktorym powinienes zmieniac swoje ustawienia.
# ikea_okazje.py aktualizuj spokojnie z GitHuba (np. git pull) - ten
# plik nigdy nie jest przez to nadpisywany, bo zyje poza repozytorium.

# --- E-mail (wymagane) ---
SMTP_USER='twoj_email@gmail.com'
SMTP_PASS='haslo_aplikacji_16_znakow'
EMAIL_TO='twoj_email@gmail.com'

# "gmail" (domyslnie), "local587" albo "exim" - patrz README.
# SMTP_MODE='gmail'

# Potrzebne tylko dla SMTP_MODE = "local587" lub "exim", jesli Twoj
# lokalny serwer pocztowy nie nazywa sie "localhost":
# SMTP_HOST='twoja-domena.pl'

# Ustaw na 'false', jesli lokalny MTA ma przeterminowany/zly certyfikat,
# a i tak ufasz temu polaczeniu (bo nie wychodzi poza Twoj serwer):
# VERIFY_TLS='true'

# --- Telegram (opcjonalny drugi kanal) - instrukcja w README ---
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''

# --- Co monitorowac ---

# Numery sklepow IKEA, oddzielone przecinkami. Domyslnie 294 (Wroclaw),
# jesli nie ustawisz.
STORE_IDS=294

# Szukane frazy, oddzielone przecinkami. Dopasowanie ignoruje wielkosc
# liter i akcenty/ogonki oraz szuka jako podciag - krotki rdzen zlapie
# tez odmiany slowa (np. "poscie" zlapie posciel/pościeli/pościelowy).
SEARCH_TERMS=Stall,poscie

# Numery artykulu do dopasowania 1:1, oddzielone przecinkami (opcjonalne).
# SEARCH_ARTICLE_NUMBERS=90557419

# --- Filtry (domyslnie wylaczone - zostaw puste, jesli nie potrzebujesz) ---

# Minimalny rabat w procentach wzgledem ceny wyjsciowej.
# MIN_DISCOUNT_PERCENT=30

# Maksymalna cena oferty (w walucie sklepu).
# MAX_PRICE=300

# Czarna lista slow-kluczowych, oddzielone przecinkami - oferta jest
# ignorowana calkowicie, jesli tytul/opis zawiera ktorekolwiek z nich.
# KEYWORDS_EXCLUDE=front,uchwyt,noga,sruba

# Jesli 'true', pierwsze uruchomienie (brak pliku stanu) wysle alert dla
# wszystkiego, co jest juz widoczne. Domyslnie 'false' (tylko zapamietuje
# stan, zeby nie zalac Cie mailami przy starcie).
# ALERT_EXISTING_ON_FIRST_RUN=false
