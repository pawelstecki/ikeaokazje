# Skopiuj ten plik do ~/.config/ikea-okazje.env i wypelnij, potem:
#   chmod 600 ~/.config/ikea-okazje.env
#
# To jest jedyne miejsce, w ktorym powinienes zmieniac swoje ustawienia.
# ikea_okazje.py aktualizuj spokojnie z GitHuba (np. git pull) - ten
# plik nigdy nie jest przez to nadpisywany, bo zyje poza repozytorium.

# --- E-mail (wymagane) ---
SMTP_USER='twoj_email@gmail.com'
SMTP_PASS='haslo_aplikacji_16_znakow'
EMAIL_TO='twoj_email@gmail.com'

# "gmail" (domyslnie), "local587" albo "exim" - patrz README.
# SMTP_MODE='gmail'

# Potrzebne tylko dla SMTP_MODE = "local587" lub "exim", jesli Twoj
# lokalny serwer pocztowy nie nazywa sie "localhost":
# SMTP_HOST='twoja-domena.pl'

# Ustaw na 'false', jesli lokalny MTA ma przeterminowany/zly certyfikat,
# a i tak ufasz temu polaczeniu (bo nie wychodzi poza Twoj serwer):
# VERIFY_TLS='true'

# --- Telegram (opcjonalny drugi kanal + komendy) - instrukcja w README ---
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''

# --- Co monitorowac (uzywane TYLKO przy pierwszym uruchomieniu - potem
#     zarzadzaj lista komendami /dodaj, /usun, /numer, /usunnumer,
#     /dodajsklep, /usunsklep w Telegramie, albo edytuj
#     ~/.ikea_okazje_dynamic.json recznie) ---

# Numery sklepow IKEA, ktore chcesz monitorowac, oddzielone przecinkami.
# Domyslnie 294 (Wroclaw). WPISZ TYLKO SKLEPY, KTORE FAKTYCZNIE CHCESZ
# SLEDZIC - nie ma potrzeby (ani sensu) ustawiac tu wszystkich sklepow na
# raz, bo kazdy dodatkowy sklep to dodatkowe zapytania do API IKEA przy
# kazdym sprawdzeniu.
STORE_IDS=294

# Pelna, potwierdzona mapa wszystkich obslugiwanych sklepow IKEA w Polsce
# (storeId - nazwa) - do wpisania w STORE_IDS powyzej. Ta sama mapa jest
# wbudowana w kod (KNOWN_STORES) i dostepna w Telegramie pod komenda
# /sklepy, wiec NIE musisz recznie uzupelniac STORE_URL_SLUGS ponizej dla
# tych sklepow - wystarczy sam numer ID.
#   1224 - Bielsko-Biala
#   429  - IKEA Bydgoszcz
#   203  - IKEA Gdansk
#   306  - IKEA Katowice
#   204  - IKEA Krakow
#   329  - IKEA Lodz
#   311  - IKEA Lublin
#   205  - IKEA Poznan
#   583  - IKEA Szczecin
#   188  - IKEA Warszawa Janki
#   307  - IKEA Warszawa Targowek
#   294  - IKEA Wroclaw

SEARCH_TERMS=Stall,poscie
# SEARCH_ARTICLE_NUMBERS=90557419

# --- Filtry (domyslnie wylaczone - zostaw puste, jesli nie potrzebujesz) ---
# MIN_DISCOUNT_PERCENT=30
# MAX_PRICE=300
# KEYWORDS_EXCLUDE=front,uchwyt,noga,sruba

# Jesli 'true', pierwsze uruchomienie wysle alert dla wszystkiego, co
# jest juz widoczne. Domyslnie 'false'.
# ALERT_EXISTING_ON_FIRST_RUN=false

# --- Linki do rezerwacji ofert ---
# Opcjonalne mapowanie storeId na slug uzywany w adresie strony "Okazje na
# Okraglo", gdy chcesz NADPISAC albo ROZSZERZYC wbudowana mape
# KNOWN_STORES (np. IKEA zmieni routing, albo chcesz dodac sklep spoza
# powyzszej listy). Dla sklepow z listy powyzej nic tu wpisywac nie musisz
# - link zostanie zbudowany automatycznie z KNOWN_STORES.
# Format: STORE_ID:slug-sklepu,STORE_ID:slug-drugiego-sklepu
# STORE_URL_SLUGS=294:wrocław

# --- Tryb pracy ---
# "cron" (domyslny) - jedno przejscie i wyjscie, uzywane z crona.
# "daemon" - dziala w petli w tle (uzyj z systemd, patrz ikea-okazje.service).
# RUN_MODE=cron

# Tylko dla RUN_MODE=daemon: jak czesto sprawdzac oferty IKEA (sekundy).
# 900 sekund = 15 minut.
# CHECK_INTERVAL_SECONDS=900

# Tylko dla RUN_MODE=daemon: jak czesto sprawdzac nowe komendy Telegrama.
# TELEGRAM_POLL_INTERVAL_SECONDS=15
